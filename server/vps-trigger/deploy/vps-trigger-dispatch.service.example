[Unit]
Description=Dispatch maplen-board Pages workflow (ranking fetch) on GitHub
Documentation=https://github.com/pachimi14/maplen-board/blob/main/server/vps-trigger/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/botuser/apps/lulumi-tools-vps-trigger
ExecStart=/home/botuser/apps/lulumi-tools-vps-trigger/dispatch_pages_workflow.sh
EnvironmentFile=/home/botuser/.config/lulumi-tools/github-dispatch.env
NoNewPrivileges=true
PrivateTmp=true
