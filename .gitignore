# this path (workflow no longer sets MVP_JSON_OUTPUT_PATH), so it is
# deliberately *not* ignored anymore -- it now holds a small, tracked
# deprecation-notice JSON (see exp_ranking/web/public/data/rankings.json)
# instead of the old ~62MB v1 export.
exp_ranking/web/public/data/rankings.json.bak
exp_ranking/web/public/data/v2/

# EXP ranking web
exp_ranking/web/node_modules/
exp_ranking/web/dist/

