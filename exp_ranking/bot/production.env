# Production fetch parameters for the home-PC daily fetch (daily_fetch.py).
# Single source of the values on the PC side. The GitHub Actions workflow
# (maplen-board-pages.yml, step "Fetch ranking and export JSON") holds a COPY of
# the same values; test_production_env_parity.py compares the two mechanically,
# and daily_fetch.py refuses to fetch if they diverge.
# No secrets here (GH_TOKEN / GH_REPO are resolved at run time from `gh`).
# Format: KEY=VALUE per line, same as config.load_env_file().
RANKING_MIN_LEVEL=225
RANKING_MAX_PAGES=2000
RANKING_REQUEST_DELAY_SEC=0.8
RANKING_UPDATE_POLL_INTERVAL_SEC=45
RANKING_UPDATE_POLL_TIMEOUT_SEC=2700
RANKING_UPDATE_SETTLE_SEC=45
RANKING_FRESHNESS_MIN_CHANGED=100
SNAPSHOT_RETENTION_DAYS=90
MVP_HISTORY_DAYS=90
MVP_EXPORT_TOP_N=0
SQLITE_DB_PATH=data/ranking.db
CHARACTER_META_JSON_PATH=data/character_meta.json
NAVIGATOR_REQUEST_DELAY_SEC=0.35
NAVIGATOR_FETCH_ENABLED=false
PAGES_SITE_URL=https://lulumi-tools.com
SKIP_RUN_IF_RANKING_DAY_EXISTS=true
SKIP_RUN_MIN_SNAPSHOT_ROWS=1000
# CI value is an expression (true unless a [web-only] commit); a manual
# dispatch run is always "true", which is what the PC run mirrors.
SNAPSHOT_IMPORT_FROM_V2_SHARDS=true
